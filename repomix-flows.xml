                                Publish
                              </button>
                            )}

                            {isPublished && (
                              <button
                                onClick={() => handleDeprecateFlow(flow.id)}
                                title="Deprecate Flow"
                                style={{
                                  padding: '6px 8px',
                                  borderRadius: '6px',
                                  background: '#FFFBEB',
                                  border: '1px solid #FDE68A',
                                  color: '#B45309',
                                  fontSize: '0.75rem',
                                  fontWeight: 600,
                                  cursor: 'pointer'
                                }}
                              >
                                Deprecate
                              </button>
                            )}
                          </>
                        )}

                        <button
                          onClick={() => handleDeleteFlow(flow.id, flow.name)}
                          title="Delete Flow"
                          style={{
                            padding: '6px 8px',
                            borderRadius: '6px',
                            background: '#FFF1F2',
                            border: '1px solid #FECDD3',
                            color: '#E11D48',
                            fontSize: '0.75rem',
                            cursor: 'pointer'
                          }}
                        >
                          <Trash2 size={13} />
                        </button>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}

      {/* TAB 2: SUBMISSIONS & RESPONSES */}
      {currentTab === 'responses' && (
        <div style={{ background: '#FFFFFF', borderRadius: '14px', border: '1px solid var(--border-color)', padding: '20px' }}>
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '18px', flexWrap: 'wrap', gap: '10px' }}>
            <div>
              <h3 style={{ margin: 0, fontSize: '1.05rem', fontWeight: 700, color: '#171719' }}>
                Customer Flow Submissions ({responses.length})
              </h3>
              <p style={{ margin: '2px 0 0', fontSize: '0.82rem', color: '#67676B' }}>
                Real-time answers submitted by customers when completing WhatsApp Flows.
              </p>
            </div>

            <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>

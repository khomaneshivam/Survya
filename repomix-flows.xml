                            borderRadius: '6px',
                            background: '#F5F5F6',
                            border: '1px solid #D4D4D9',
                            color: '#3A3A3E',
                            fontSize: '0.78rem',
                            fontWeight: 600,
                            cursor: 'pointer',
                            display: 'flex',
                            alignItems: 'center',
                            gap: '4px'
                          }}

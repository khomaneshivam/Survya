<file path="frontend/src/pages/FlowsPage.jsx">
import React, { useState, useEffect } from 'react';
import { useAuth } from '../context/AuthContext';
import { 
  Layers, 
  Plus, 
  RefreshCw, 
  Search, 
  Send, 
  Key, 
  CheckCircle2, 
  AlertCircle, 
  ExternalLink, 
  Trash2, 
  Edit3, 
  UploadCloud, 
  Copy, 
  Check, 
  X, 
  Sparkles, 
  Inbox
} from 'lucide-react';

export default function FlowsPage() {
  const { token, isAdmin } = useAuth();

  // Tab navigation
  const [currentTab, setCurrentTab] = useState('flows'); // 'flows' | 'responses' | 'crypto'

  // Flows list state
  const [flows, setFlows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [_error, setError] = useState(null);
  const [search, setSearch] = useState('');
  const [categoryFilter, setCategoryFilter] = useState('ALL');
  const [statusFilter, setStatusFilter] = useState('ALL');
  const [isFeatureEnabled, setIsFeatureEnabled] = useState(true);

  // Starter templates
  const [starterTemplates, setStarterTemplates] = useState([]);

  // Modals & Drawers
  const [isEditorOpen, setIsEditorOpen] = useState(false);
  const [editingFlow, setEditingFlow] = useState(null);
  const [isTestSendOpen, setIsTestSendOpen] = useState(false);
  const [testSendFlow, setTestSendFlow] = useState(null);

  // Form Editor state
  const [formName, setFormName] = useState('');
  const [formDescription, setFormDescription] = useState('');
  const [formCategory, setFormCategory] = useState('LEAD_GENERATION');
  const [formEndpoint, setFormEndpoint] = useState('');
  const [formJson, setFormJson] = useState('');
  const [jsonError, setJsonError] = useState(null);
  const [savingFlow, setSavingFlow] = useState(false);
  const [pushingMeta, setPushingMeta] = useState(false);

  // Test Send state
  const [testPhone, setTestPhone] = useState('');
  const [testBody, setTestBody] = useState('');
  const [testCta, setTestCta] = useState('Open Form');
  const [sendingTest, setSendingTest] = useState(false);
  const [testResult, setTestResult] = useState(null);

  // Submissions state
  const [responses, setResponses] = useState([]);
  const [loadingResponses, setLoadingResponses] = useState(false);
  const [responseSearch, setResponseSearch] = useState('');
  const [selectedResponse, setSelectedResponse] = useState(null);

  // Crypto config state
  const [cryptoConfig, setCryptoConfig] = useState(null);
  const [loadingCrypto, setLoadingCrypto] = useState(false);
  const [copiedKey, setCopiedKey] = useState(false);
  const [generatingKey, setGeneratingKey] = useState(false);
  const [showPasteKey, setShowPasteKey] = useState(false);
  const [pastedKeyText, setPastedKeyText] = useState('');
  const [savingPastedKey, setSavingPastedKey] = useState(false);

  // Notification Banner
  const [notification, setNotification] = useState(null);

  const showNotification = (msg, type = 'success') => {
    setNotification({ msg, type });
    setTimeout(() => setNotification(null), 6000);
  };

  // Fetch Flows
  const fetchFlows = async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await fetch('/api/flows', {
        headers: { Authorization: `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        setFlows(data.data || []);
        setIsFeatureEnabled(data.isFeatureEnabled !== false);
      } else {
        const msg = data.message || 'Failed to load flows.';
        setError(msg);
        showNotification(msg, 'error');
      }
    } catch (err) {
      setError('Network connection error fetching flows.');
      showNotification('Network connection error fetching flows.', 'error');
    } finally {
      setLoading(false);
    }
  };

  // Fetch Starter Templates
  const fetchStarterTemplates = async () => {
    try {
      const res = await fetch('/api/flows/starter-templates', {
        headers: { Authorization: `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        setStarterTemplates(data.data || []);
      }
    } catch (e) {}
  };

  // Fetch Responses
  const fetchResponses = async () => {
    setLoadingResponses(true);
    try {
      const res = await fetch('/api/flows/responses', {
        headers: { Authorization: `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        setResponses(data.data || []);
      }
    } catch (e) {
    } finally {
      setLoadingResponses(false);
    }
  };

  // Fetch Crypto Config
  const fetchCryptoConfig = async () => {
    setLoadingCrypto(true);
    try {
      const res = await fetch('/api/flows/crypto/config', {
        headers: { Authorization: `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        setCryptoConfig(data);
      }
    } catch (e) {}
    finally {
      setLoadingCrypto(false);
    }
  };

  useEffect(() => {
    fetchFlows();
    fetchStarterTemplates();
  }, [token]);

  useEffect(() => {
    if (currentTab === 'responses') {
      fetchResponses();
    } else if (currentTab === 'crypto') {
      fetchCryptoConfig();
    }
  }, [currentTab]);

  // Sync with Meta
  const handleSyncMeta = async () => {
    try {
      setLoading(true);
      const res = await fetch('/api/flows/sync', {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        showNotification(data.message || 'Flows successfully synchronized with Meta.');
        fetchFlows();
      } else {
        showNotification(data.message || 'Sync failed.', 'error');
      }
    } catch (e) {
      showNotification(e.message, 'error');
    } finally {
      setLoading(false);
    }
  };

  // Open Editor for Create
  const handleOpenCreate = (templateKey = null) => {
    setEditingFlow(null);
    setJsonError(null);

    if (templateKey) {
      const tpl = starterTemplates.find(t => t.key === templateKey);
      if (tpl) {
        setFormName(tpl.name);
        setFormDescription(tpl.description);
        setFormCategory(tpl.category || 'LEAD_GENERATION');
        setFormEndpoint('');
        setFormJson(JSON.stringify(tpl.flow_json, null, 2));
      }
    } else {
      setFormName('');
      setFormDescription('');
      setFormCategory('LEAD_GENERATION');
      setFormEndpoint('');
      const defaultTpl = starterTemplates[0]?.flow_json || {
        version: "3.1",
        data_api_version: "3.0",
        routing_model: { SCREEN_0: [] },
        screens: [{ id: "SCREEN_0", title: "Customer Form", terminal: true, layout: { type: "SingleColumnLayout", children: [] } }]
      };
      setFormJson(JSON.stringify(defaultTpl, null, 2));
    }
    setIsEditorOpen(true);
  };

  // Open Editor for Edit
  const handleOpenEdit = (flow) => {
    setEditingFlow(flow);
    setFormName(flow.name);
    setFormDescription(flow.description || '');
    setFormCategory(flow.categories?.[0] || 'OTHER');
    setFormEndpoint(flow.endpoint_uri || '');
    setJsonError(null);

    const jsonStr = typeof flow.flow_json === 'object' ? JSON.stringify(flow.flow_json, null, 2) : flow.flow_json;
    setFormJson(jsonStr);
    setIsEditorOpen(true);
  };

  // Save Flow Draft
  const handleSaveFlow = async () => {
    setJsonError(null);
    let parsed = null;
    try {
      parsed = JSON.parse(formJson);
    } catch (err) {
      setJsonError('Invalid JSON: ' + err.message);
      return;
    }

    if (!formName.trim()) {
      showNotification('Please enter a Flow name.', 'error');
      return;
    }

    setSavingFlow(true);
    try {
      const url = editingFlow ? `/api/flows/${editingFlow.id}` : '/api/flows';
      const method = editingFlow ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify({
          name: formName,
          description: formDescription,
          categories: [formCategory],
          endpoint_uri: formEndpoint,
          flow_json: parsed
        })
      });

      const data = await res.json();
      if (data.success) {
        showNotification(data.message || 'Flow saved successfully!');
        setIsEditorOpen(false);
        fetchFlows();
      } else {
        if (data.errors && data.errors.length > 0) {
          setJsonError(data.errors.join(' | '));
        } else {
          showNotification(data.message || 'Failed to save Flow.', 'error');
        }
      }
    } catch (err) {
      showNotification(err.message, 'error');
    } finally {
      setSavingFlow(false);
    }
  };

  // Push to Meta
  const handlePushToMeta = async (flowId) => {
    if (!window.confirm("Upload this Flow definition and assets to Meta WhatsApp Business Platform?")) return;
    setPushingMeta(true);
    try {
      const res = await fetch(`/api/flows/${flowId}/push`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        showNotification(data.message || 'Flow pushed to Meta successfully!');
        fetchFlows();
      } else {
        const errorDetails = data.validationErrors?.length > 0
          ? data.validationErrors.map(e => `${e.error || e.message}`).join(', ')
          : data.message;
        showNotification(`Meta Upload Notice: ${errorDetails}`, 'error');
      }
    } catch (err) {
      showNotification(err.message, 'error');
    } finally {
      setPushingMeta(false);
    }
  };

  // Publish Flow
  const handlePublishFlow = async (flowId) => {
    if (!window.confirm("Publishing this Flow makes it live for all customers on WhatsApp. Do you want to proceed?")) return;
    try {
      const res = await fetch(`/api/flows/${flowId}/publish`, {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}` 
        }
      });
      const data = await res.json();
      if (data.success) {
        showNotification(data.message || 'Flow published successfully!');
        fetchFlows();
      } else if (data.isIntegrityBlock) {
        if (window.confirm(`${data.message}\n\nMeta requires Business Verification in Meta Business Suite before live publishing.\n\nWould you like to activate this Flow locally for testing & your Automated Concierge?`)) {
          const localRes = await fetch(`/api/flows/${flowId}/publish`, {
            method: 'POST',
            headers: { 
              'Content-Type': 'application/json',
              Authorization: `Bearer ${token}` 
            },
            body: JSON.stringify({ forceLocal: true })
          });
          const localData = await localRes.json();
          if (localData.success) {
            showNotification(localData.message || 'Flow activated locally!');
            fetchFlows();
            return;
          }
        }
        showNotification(data.message, 'error');
      } else {
        showNotification(data.message || 'Publishing failed.', 'error');
      }
    } catch (err) {
      showNotification(err.message, 'error');
    }
  };

  // Deprecate Flow
  const handleDeprecateFlow = async (flowId) => {
    if (!window.confirm("Deprecate this Flow? Deprecated flows cannot be sent to new recipients.")) return;
    try {
      const res = await fetch(`/api/flows/${flowId}/deprecate`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        showNotification(data.message || 'Flow deprecated.');
        fetchFlows();
      } else {
        showNotification(data.message, 'error');
      }
    } catch (err) {
      showNotification(err.message, 'error');
    }
  };

  // Delete Flow
  const handleDeleteFlow = async (flowId, flowName) => {
    if (!window.confirm(`Are you sure you want to delete the flow "${flowName}"? This action cannot be undone.`)) return;
    try {
      const res = await fetch(`/api/flows/${flowId}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        showNotification('Flow deleted successfully.');
        fetchFlows();
      } else {
        showNotification(data.message, 'error');
      }
    } catch (err) {
      showNotification(err.message, 'error');
    }
  };

  // Open Test Send Modal
  const handleOpenTestSend = (flow) => {
    setTestSendFlow(flow);
    setTestPhone('');
    setTestBody(`Hi! Please take a moment to complete the ${flow.name} form below:`);
    setTestCta('Open Form');
    setTestResult(null);
    setIsTestSendOpen(true);
  };

  // Submit Test Send
  const handleSendTestFlow = async () => {
    if (!testPhone.trim()) {
      showNotification('Please enter a recipient phone number.', 'error');
      return;
    }

    setSendingTest(true);
    setTestResult(null);
    try {
      const res = await fetch(`/api/flows/${testSendFlow.id}/send-test`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify({
          to: testPhone,
          bodyText: testBody,
          ctaText: testCta,
          headerText: testSendFlow.name,
          footerText: 'KonkanTrip Concierge'
        })
      });

      const data = await res.json();
      if (data.success) {
        setTestResult({
          type: 'success',
          msg: data.message,
          messageId: data.messageId,
          flowToken: data.flowToken
        });
        showNotification('Flow message dispatched successfully!');
      } else {
        setTestResult({
          type: 'error',
          msg: data.message
        });
      }
    } catch (err) {
      setTestResult({ type: 'error', msg: err.message });
    } finally {
      setSendingTest(false);
    }
  };

  // Generate Keypair
  const handleGenerateKeypair = async () => {
    if (!window.confirm("Generate a new RSA 2048-bit keypair for WhatsApp Flows Data-Exchange? This will replace any existing keys.")) return;
    setGeneratingKey(true);
    try {
      const res = await fetch('/api/flows/crypto/generate-keypair', {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        showNotification(data.message || 'New keypair generated!');
        fetchCryptoConfig();
      } else {
        showNotification(data.message, 'error');
      }
    } catch (err) {
      showNotification(err.message, 'error');
    } finally {
      setGeneratingKey(false);
    }
  };

  // Save Custom / Pasted RSA Private Key
  const handleSavePastedKey = async () => {
    if (!pastedKeyText.trim()) return;
    setSavingPastedKey(true);
    try {
      const res = await fetch('/api/flows/crypto/save-private-key', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify({ privateKey: pastedKeyText.trim() })
      });
      const data = await res.json();
      if (data.success) {
        showNotification(data.message || 'Private key saved and public key derived!');
        setPastedKeyText('');
        setShowPasteKey(false);
        fetchCryptoConfig();
      } else {
        showNotification(data.message || 'Failed to save private key', 'error');
      }
    } catch (err) {
      showNotification(err.message, 'error');
    } finally {
      setSavingPastedKey(false);
    }
  };

  // Copy Key to Clipboard
  const handleCopyKey = () => {
    if (cryptoConfig?.publicKey) {
      navigator.clipboard.writeText(cryptoConfig.publicKey);
      setCopiedKey(true);
      setTimeout(() => setCopiedKey(false), 3000);
    }
  };

  // Filtered Flows
  const filteredFlows = flows.filter(f => {
    const matchesSearch = !search || 
      f.name?.toLowerCase().includes(search.toLowerCase()) ||
      f.description?.toLowerCase().includes(search.toLowerCase()) ||
      f.meta_flow_id?.includes(search);
    
    const matchesCat = categoryFilter === 'ALL' || f.categories?.includes(categoryFilter);
    const matchesStatus = statusFilter === 'ALL' || f.status === statusFilter;
    return matchesSearch && matchesCat && matchesStatus;
  });

  return (
    <div style={{ maxWidth: '1440px', margin: '0 auto', padding: '24px 20px 48px' }}>
      
      {/* Top Banner / Notifications */}
      {notification && (
        <div style={{
          marginBottom: '20px',
          padding: '12px 18px',
          borderRadius: '10px',
          background: notification.type === 'error' ? '#FDF0F0' : '#EDF4E6',
          color: notification.type === 'error' ? '#9B2C2C' : '#2F5219',
          border: `1px solid ${notification.type === 'error' ? '#FCA5A5' : '#C3D1AC'}`,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          fontSize: '0.9rem',
          fontWeight: 600,
          boxShadow: '0 2px 6px rgba(0,0,0,0.04)'
        }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
            {notification.type === 'error' ? <AlertCircle size={18} /> : <CheckCircle2 size={18} />}
            <span>{notification.msg}</span>
          </div>
          <button 
            onClick={() => setNotification(null)}
            style={{ background: 'none', border: 'none', cursor: 'pointer', color: 'inherit' }}
          >
            <X size={16} />
          </button>
        </div>
      )}

      {/* Feature Flag Notice if Disabled */}
      {!isFeatureEnabled && (
        <div style={{
          marginBottom: '24px',
          padding: '16px 20px',
          borderRadius: '12px',
          background: '#FFFBEB',
          border: '1px solid #FDE68A',
          color: '#92400E',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          gap: '12px'
        }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
            <AlertCircle size={20} color="#D97706" />
            <div>
              <strong style={{ fontSize: '0.95rem' }}>WhatsApp Flows Feature is Disabled</strong>
              <div style={{ fontSize: '0.82rem', marginTop: '2px', color: '#B45309' }}>
                Flow creation and test sending are currently in preview mode. Administrators can enable this feature under Line & API Settings.
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Page Header */}
      <div style={{
        display: 'flex',
        flexWrap: 'wrap',
        alignItems: 'center',
        justifyContent: 'space-between',
        gap: '16px',
        marginBottom: '28px'
      }}>
        <div>
          <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
            <div style={{
              width: '38px',
              height: '38px',
              borderRadius: '8px',
              background: 'var(--sarvya-blue-soft)',
              border: '1px solid var(--sarvya-blue-border)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              color: 'var(--sarvya-blue)'
            }}>
              <Layers size={20} />
            </div>
            <div>
              <h1 className="sarvya-page-title">
                SARVYA Forms — Interactive Flows
              </h1>
              <p className="sarvya-page-desc">
                Design, inspect, publish, and dispatch native WhatsApp interactive data collection forms.
              </p>
            </div>
          </div>
        </div>

        {/* Global Action Buttons */}
        <div style={{ display: 'flex', alignItems: 'center', gap: '10px', flexWrap: 'wrap' }}>
          {isAdmin && (
            <button
              onClick={handleSyncMeta}
              disabled={loading}
              style={{
                display: 'flex',
                alignItems: 'center',
                gap: '8px',
                padding: '9px 16px',
                borderRadius: '8px',
                background: '#FFFFFF',
                border: '1px solid #D4D4D9',
                color: '#3A3A3E',
                fontSize: '0.85rem',
                fontWeight: 600,
                cursor: loading ? 'not-allowed' : 'pointer',
                transition: 'all 0.2s ease',
                boxShadow: '0 1px 3px rgba(0,0,0,0.05)'
              }}
            >
              <RefreshCw size={15} className={loading ? 'animate-spin' : ''} />
              Sync with Meta
            </button>
          )}

          <button
            onClick={() => handleOpenCreate()}
            className="sarvya-btn sarvya-btn-primary"
          >
            <Plus size={15} strokeWidth={2.2} />
            Create Form
          </button>
        </div>
      </div>

      {/* Tabs */}
      <div style={{
        display: 'flex',
        borderBottom: '1px solid var(--border-color)',
        marginBottom: '24px',
        gap: '8px'
      }}>
        <button
          onClick={() => setCurrentTab('flows')}
          style={{
            padding: '10px 18px',
            background: 'none',
            border: 'none',
            borderBottom: currentTab === 'flows' ? '3px solid #2876B8' : '3px solid transparent',
            color: currentTab === 'flows' ? '#2876B8' : '#67676B',
            fontWeight: currentTab === 'flows' ? 700 : 500,
            fontSize: '0.92rem',
            cursor: 'pointer',
            display: 'flex',
            alignItems: 'center',
            gap: '8px'
          }}
        >
          <Layers size={17} />
          Flows Library ({flows.length})
        </button>

        <button
          onClick={() => setCurrentTab('responses')}
          style={{
            padding: '10px 18px',
            background: 'none',
            border: 'none',
            borderBottom: currentTab === 'responses' ? '3px solid #2876B8' : '3px solid transparent',
            color: currentTab === 'responses' ? '#2876B8' : '#67676B',
            fontWeight: currentTab === 'responses' ? 700 : 500,
            fontSize: '0.92rem',
            cursor: 'pointer',
            display: 'flex',
            alignItems: 'center',
            gap: '8px'
          }}
        >
          <Inbox size={17} />
          Customer Submissions
        </button>

        <button
          onClick={() => setCurrentTab('crypto')}
          style={{
            padding: '10px 18px',
            background: 'none',
            border: 'none',
            borderBottom: currentTab === 'crypto' ? '3px solid #2876B8' : '3px solid transparent',
            color: currentTab === 'crypto' ? '#2876B8' : '#67676B',
            fontWeight: currentTab === 'crypto' ? 700 : 500,
            fontSize: '0.92rem',
            cursor: 'pointer',
            display: 'flex',
            alignItems: 'center',
            gap: '8px'
          }}
        >
          <Key size={17} />
          Endpoint & Encryption Keys
        </button>
      </div>

      {/* TAB 1: FLOWS DIRECTORY */}
      {currentTab === 'flows' && (
        <div>
          {/* Starter Template Highlights */}
          {flows.length === 0 && !loading && (
            <div style={{
              background: '#FFFFFF',
              borderRadius: '14px',
              padding: '24px',
              border: '1px solid var(--border-color)',
              marginBottom: '28px'
            }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '14px' }}>
                <Sparkles size={20} color="#D97706" />
                <h3 style={{ margin: 0, fontSize: '1.05rem', fontWeight: 700, color: '#171719' }}>
                  Quick Start with Validated Templates
                </h3>
              </div>
              <p style={{ margin: '0 0 16px', fontSize: '0.85rem', color: '#67676B' }}>
                Select a pre-designed Meta Flow template to customize and deploy in seconds:
              </p>
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(260px, 1fr))', gap: '14px' }}>
                {starterTemplates.map(tpl => (
                  <div
                    key={tpl.key}
                    onClick={() => handleOpenCreate(tpl.key)}
                    style={{
                      border: '1px solid #E5E5E8',
                      borderRadius: '10px',
                      padding: '16px',
                      cursor: 'pointer',
                      background: '#F5F5F6',
                      transition: 'all 0.2s ease'
                    }}
                    onMouseEnter={(e) => { e.currentTarget.style.borderColor = '#2876B8'; e.currentTarget.style.background = '#F3F6EE'; }}
                    onMouseLeave={(e) => { e.currentTarget.style.borderColor = '#E5E5E8'; e.currentTarget.style.background = '#F5F5F6'; }}
                  >
                    <div style={{ fontWeight: 700, color: '#171719', fontSize: '0.92rem' }}>{tpl.name}</div>
                    <div style={{ fontSize: '0.78rem', color: '#67676B', marginTop: '4px', lineHeight: 1.4 }}>{tpl.description}</div>
                    <div style={{ display: 'flex', alignItems: 'center', gap: '6px', marginTop: '10px' }}>
                      <span style={{ fontSize: '0.7rem', padding: '2px 8px', borderRadius: '4px', background: '#E0F2FE', color: '#0369A1', fontWeight: 600 }}>
                        {tpl.category}
                      </span>
                      <span style={{ fontSize: '0.75rem', color: '#2876B8', fontWeight: 600, marginLeft: 'auto' }}>
                        Use Template →
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Filter Bar */}
          <div style={{
            display: 'flex',
            flexWrap: 'wrap',
            alignItems: 'center',
            justifyContent: 'space-between',
            gap: '12px',
            marginBottom: '20px'
          }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: '10px', flex: 1, minWidth: '240px', maxWidth: '400px' }}>
              <div style={{ position: 'relative', width: '100%' }}>
                <Search size={16} color="#96969C" style={{ position: 'absolute', left: '12px', top: '50%', transform: 'translateY(-50%)' }} />
                <input
                  type="text"
                  placeholder="Search flows by name or ID..."
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  style={{
                    width: '100%',
                    padding: '8px 12px 8px 36px',
                    borderRadius: '8px',
                    border: '1px solid #D4D4D9',
                    fontSize: '0.85rem'
                  }}
                />
              </div>
            </div>

            <div style={{ display: 'flex', alignItems: 'center', gap: '10px', flexWrap: 'wrap' }}>
              <select
                value={categoryFilter}
                onChange={(e) => setCategoryFilter(e.target.value)}
                style={{
                  padding: '8px 12px',
                  borderRadius: '8px',
                  border: '1px solid #D4D4D9',
                  fontSize: '0.82rem',
                  background: '#FFFFFF',
                  color: '#3A3A3E'
                }}
              >
                <option value="ALL">All Categories</option>
                <option value="LEAD_GENERATION">Lead Generation</option>
                <option value="APPOINTMENT_BOOKING">Appointment Booking</option>
                <option value="CUSTOMER_SUPPORT">Customer Support</option>
                <option value="SURVEY">Feedback / Survey</option>
                <option value="OTHER">Other</option>
              </select>

              <select
                value={statusFilter}
                onChange={(e) => setStatusFilter(e.target.value)}
                style={{
                  padding: '8px 12px',
                  borderRadius: '8px',
                  border: '1px solid #D4D4D9',
                  fontSize: '0.82rem',
                  background: '#FFFFFF',
                  color: '#3A3A3E'
                }}
              >
                <option value="ALL">All Statuses</option>
                <option value="DRAFT">Draft</option>
                <option value="PUBLISHED">Published</option>
                <option value="DEPRECATED">Deprecated</option>
              </select>
            </div>
          </div>

          {/* Flows Grid */}
          {loading ? (
            <div style={{ padding: '60px 20px', textAlign: 'center', color: '#96969C' }}>
              <RefreshCw size={28} className="animate-spin" style={{ margin: '0 auto 12px', color: '#2876B8' }} />
              <div>Loading WhatsApp Flows...</div>
            </div>
          ) : filteredFlows.length === 0 ? (
            <div style={{
              background: '#FFFFFF',
              border: '1px dashed #D4D4D9',
              borderRadius: '14px',
              padding: '60px 20px',
              textAlign: 'center'
            }}>
              <Layers size={40} color="#96969C" style={{ margin: '0 auto 12px' }} />
              <h3 style={{ margin: '0 0 6px', fontSize: '1.1rem', color: '#171719' }}>No WhatsApp Flows Found</h3>
              <p style={{ margin: '0 0 18px', color: '#67676B', fontSize: '0.85rem' }}>
                {search ? 'Try clearing your search terms or filters.' : 'Create your first Flow using one of our starter templates.'}
              </p>
              <button
                onClick={() => handleOpenCreate()}
                style={{
                  padding: '9px 18px',
                  borderRadius: '8px',
                  background: '#2876B8',
                  color: '#FFFFFF',
                  border: 'none',
                  fontWeight: 600,
                  fontSize: '0.85rem',
                  cursor: 'pointer'
                }}
              >
                Create New Flow
              </button>
            </div>
          ) : (
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(360px, 1fr))', gap: '18px' }}>
              {filteredFlows.map(flow => {
                const isPublished = flow.status === 'PUBLISHED';
                const isDraft = flow.status === 'DRAFT';
                const isDeprecated = flow.status === 'DEPRECATED';

                return (
                  <div
                    key={flow.id}
                    style={{
                      background: '#FFFFFF',
                      borderRadius: '12px',
                      border: '1px solid var(--border-color)',
                      padding: '20px',
                      display: 'flex',
                      flexDirection: 'column',
                      justifyContent: 'space-between',
                      boxShadow: '0 2px 6px rgba(0,0,0,0.03)',
                      transition: 'transform 0.2s ease, box-shadow 0.2s ease'
                    }}
                  >
                    <div>
                      {/* Top Header of Card */}
                      <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', gap: '10px' }}>
                        <div>
                          <h3 style={{ margin: 0, fontSize: '1rem', fontWeight: 700, color: '#171719', lineHeight: 1.3 }}>
                            {flow.name}
                          </h3>
                          <div style={{ fontSize: '0.75rem', color: '#67676B', marginTop: '4px', fontFamily: 'monospace' }}>
                            {flow.meta_flow_id ? `Meta ID: ${flow.meta_flow_id}` : 'Local Draft (Not Pushed)'}
                          </div>
                        </div>

                        {/* Status Badge */}
                        <span style={{
                          padding: '3px 8px',
                          borderRadius: '6px',
                          fontSize: '0.72rem',
                          fontWeight: 700,
                          background: isPublished ? '#EDF4E6' : (isDraft ? '#FEF3C7' : (isDeprecated ? '#FDF0F0' : '#EEEEF0')),
                          color: isPublished ? '#2F5219' : (isDraft ? '#B45309' : (isDeprecated ? '#9B2C2C' : '#67676B')),
                          border: `1px solid ${isPublished ? '#C3D1AC' : (isDraft ? '#FDE68A' : (isDeprecated ? '#FDB1AF' : '#E5E5E8'))}`
                        }}>
                          {flow.status}
                        </span>
                      </div>

                      {/* Description */}
                      <p style={{
                        fontSize: '0.82rem',
                        color: '#67676B',
                        margin: '12px 0 16px',
                        lineHeight: 1.4,
                        minHeight: '36px'
                      }}>
                        {flow.description || 'No description provided.'}
                      </p>

                      {/* Meta Pills */}
                      <div style={{ display: 'flex', flexWrap: 'wrap', gap: '6px', marginBottom: '16px' }}>
                        {flow.categories?.map((cat, idx) => (
                          <span key={idx} style={{
                            fontSize: '0.7rem',
                            padding: '2px 8px',
                            borderRadius: '4px',

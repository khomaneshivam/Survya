                  padding: '7px 12px',
                  borderRadius: '8px',
                  background: '#F5F5F6',
                  border: '1px solid #D4D4D9',
                  color: '#3A3A3E',
                  fontSize: '0.82rem',
                  fontWeight: 600,
                  cursor: 'pointer',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '6px'
                }}

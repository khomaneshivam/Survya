                <textarea
                  readOnly
                  rows={6}
                  value={cryptoConfig.publicKey}
                  style={{
                    width: '100%',
                    fontFamily: 'monospace',
                    fontSize: '0.75rem',
                    padding: '10px',
                    borderRadius: '8px',
                    border: '1px solid #D4D4D9',
                    background: '#F5F5F6',
                    color: '#3A3A3E'
                  }}
                />
              </div>
            ) : (
              <div style={{ fontSize: '0.82rem', color: '#67676B', fontStyle: 'italic' }}>

                      </div>
                      <div style={{ display: 'flex', gap: '16px', alignItems: 'center' }}>
                        <div>
                          <label style={{ display: 'block', fontSize: '0.76rem', color: '#64748B' }}>Pause Bot Duration (mins)</label>
                          <input
                            type="number"

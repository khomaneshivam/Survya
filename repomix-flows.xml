                    Cancel
                  </button>
                  <button
                    type="button"
                    disabled={savingPastedKey || !pastedKeyText.trim()}
                    onClick={handleSavePastedKey}
                    style={{ padding: '6px 14px', borderRadius: '6px', background: '#2F5219', color: '#FFFFFF', border: 'none', fontSize: '0.78rem', fontWeight: 700, cursor: 'pointer' }}
                  >
                    {savingPastedKey ? 'Saving...' : 'Save & Derive Public Key'}
                  </button>
                </div>
              </div>
            )}

            {/* Public Key Display */}
            {cryptoConfig?.publicKey ? (
              <div>
                <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '6px' }}>
                  <label style={{ fontSize: '0.82rem', fontWeight: 700, color: '#3A3A3E' }}>
                    RSA Public Key (Upload this to Meta WhatsApp Manager):
                  </label>
                  <button
                    onClick={handleCopyKey}
                    style={{
                      background: 'none',
                      border: 'none',
                      color: '#2876B8',
                      fontSize: '0.78rem',
                      fontWeight: 600,
                      cursor: 'pointer',
                      display: 'flex',
                      alignItems: 'center',
                      gap: '4px'
                    }}
                  >
                    {copiedKey ? <Check size={14} color="#2876B8" /> : <Copy size={14} />}

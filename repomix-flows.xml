                              .map(([k, v], idx) => (
                                <span key={idx} style={{
                                  fontSize: '0.72rem',
                                  padding: '2px 6px',
                                  borderRadius: '4px',
                                  background: '#EEEEF0',
                                  color: '#3A3A3E'
                                }}>
                                  <strong>{k.replace(/^[a-zA-Z0-9]+_/, '')}:</strong> {typeof v === 'object' ? JSON.stringify(v) : String(v)}
                                </span>
                              ))}
                          </div>
                        </td>
                        <td style={{ padding: '12px 14px', textAlign: 'right' }}>
                          <button
                            onClick={() => setSelectedResponse(item)}
                            style={{
                              padding: '5px 10px',
                              borderRadius: '6px',
                              background: '#F5F5F6',
                              border: '1px solid #D4D4D9',
                              color: '#3A3A3E',
                              fontSize: '0.75rem',
                              fontWeight: 600,
                              cursor: 'pointer'
                            }}
                          >
                            View Details
                          </button>
                        </td>
                      </tr>
                    ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      )}

      {/* TAB 3: ENDPOINT & ENCRYPTION KEYS */}

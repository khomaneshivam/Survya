/**
 * Validates a conversation flow graph deterministically on the client side.
 * Returns { isValid, errors, warnings, allIssues } with precise node IDs for interactive canvas navigation.
 */
export function validateFlowGraph(nodes = [], transitions = []) {
  const errors = [];
  const warnings = [];

  const safeNodes = Array.isArray(nodes) ? nodes : [];
  const safeTransitions = Array.isArray(transitions) ? transitions : [];

  if (safeNodes.length === 0) {
    errors.push({
      nodeId: null,
      severity: 'error',
      message: 'Flow contains no steps. Drag a Trigger from the left palette to begin.'
    });
    return {
      isValid: false,
      errors,
      warnings,
      allIssues: errors
    };
  }

  const nodeMap = new Map();
  safeNodes.forEach((node) => {
    if (!node.id) {
      errors.push({
        nodeId: null,
        severity: 'error',
        message: 'All steps must have a unique identifier.'
      });
    } else if (nodeMap.has(node.id)) {
      errors.push({
        nodeId: node.id,
        severity: 'error',
        message: `Duplicate step ID detected: '${node.id}'.`
      });
    } else {
      nodeMap.set(node.id, node);
    }
  });

  // 1. Trigger / Start Step Check
  const triggerTypes = new Set(['START', 'TRIGGER_WHATSAPP', 'TRIGGER_EVENT']);
  const triggerNodes = safeNodes.filter((n) => triggerTypes.has(n.type));

  if (triggerNodes.length === 0) {
    errors.push({
      nodeId: null,
      severity: 'error',
      message: 'No trigger or start step present. Add a WhatsApp Trigger to begin.'
    });
  } else if (triggerNodes.length > 1) {
    warnings.push({
      nodeId: triggerNodes[1].id,
      severity: 'warning',
      message: `${triggerNodes.length} trigger steps detected. Only one primary trigger is recommended.`
    });
  }

  // 2. Transitions Validity Check
  const outgoingMap = new Map(); // sourceId -> array of transitions
  const incomingMap = new Map(); // targetId -> array of transitions
  safeNodes.forEach((n) => {
    outgoingMap.set(n.id, []);
    incomingMap.set(n.id, []);
  });

  safeTransitions.forEach((t, idx) => {
    if (!t.source || !nodeMap.has(t.source)) {
      errors.push({
        nodeId: t.source || null,
        severity: 'error',
        message: `Connection #${idx + 1} has an invalid or missing source step '${t.source}'.`
      });
    } else {
      outgoingMap.get(t.source).push(t);
    }

    if (!t.target || !nodeMap.has(t.target)) {
      errors.push({
        nodeId: t.target || null,
        severity: 'error',
        message: `Connection #${idx + 1} has an invalid or missing target step '${t.target}'.`
      });
    } else {
      incomingMap.get(t.target).push(t);
    }
  });

  // 3. Node Configuration & Required Fields Check
  safeNodes.forEach((node) => {
    const config = node.config || {};
    const type = node.type;

    // Send Message / Message
    if (type === 'SEND_MESSAGE' || type === 'MESSAGE') {
      const text = config.text || '';
      const options = config.options || [];
      const mediaUrl = config.mediaUrl || '';
      if (!text.trim() && options.length === 0 && !mediaUrl) {
        errors.push({
          nodeId: node.id,
          severity: 'error',
          message: `Message step '${node.title || node.id}' has empty content and no options.`
        });
      }
    }

    // Send Template
    if (type === 'SEND_TEMPLATE') {
      if (!config.templateName || !String(config.templateName).trim()) {
        errors.push({
          nodeId: node.id,
          severity: 'error',
          message: `Template step '${node.title || node.id}' is missing Meta template name.`
        });
      }
    }

    // WhatsApp Flow Form
    if (type === 'SEND_WHATSAPP_FLOW') {
      if (!config.metaFlowId || !String(config.metaFlowId).trim()) {
        warnings.push({
          nodeId: node.id,
          severity: 'warning',
          message: `Meta Flow step '${node.title || node.id}' is missing Meta Flow ID.`
        });
      }
    }

    // Collect Input
    if (type === 'COLLECT_INPUT' || type === 'INPUT_COLLECTION' || type === 'QUESTION') {
      const variableName = config.saveAs || config.variable;
      if (!variableName || !String(variableName).trim()) {
        errors.push({
          nodeId: node.id,
          severity: 'error',
          message: `Data Intake step '${node.title || node.id}' must specify a variable name to save input (e.g. check_in_date).`
        });
      }
      if (!config.prompt || !String(config.prompt).trim()) {
        warnings.push({
          nodeId: node.id,
          severity: 'warning',
          message: `Data Intake step '${node.title || node.id}' has an empty question prompt.`
        });
      }
    }

    // Condition
    if (type === 'CONDITION') {
      const rules = config.rules || [];
      const variable = config.variable;
      if (rules.length === 0 && !variable && !config.defaultTargetNodeId) {
        errors.push({
          nodeId: node.id,
          severity: 'error',
          message: `Condition step '${node.title || node.id}' has no evaluation rules.`
        });
      }
    }

    // Webhook / API
    if (type === 'HTTP_WEBHOOK' || type === 'API_INTEGRATION') {
      if (!config.url || !String(config.url).trim()) {
        errors.push({
          nodeId: node.id,
          severity: 'error',
          message: `Webhook step '${node.title || node.id}' is missing endpoint URL.`
        });
      }
    }

    // Catalog & Booking
    if (type === 'CATALOG_BOOKING' || type === 'BUSINESS_ACTION') {
      if (!config.action && !config.entityType) {
        errors.push({
          nodeId: node.id,
          severity: 'error',
          message: `Booking step '${node.title || node.id}' does not have an action specified.`
        });
      }
    }
  });

  // 4. Reachability & Disconnected Node Check
  if (triggerNodes.length >= 1) {
    const startId = triggerNodes[0].id;
    const visited = new Set([startId]);
    const queue = [startId];

    while (queue.length > 0) {
      const currId = queue.shift();
      const transitionsFromCurr = outgoingMap.get(currId) || [];

      transitionsFromCurr.forEach((t) => {
        if (!visited.has(t.target)) {
          visited.add(t.target);
          queue.push(t.target);
        }
      });
    }

    safeNodes.forEach((node) => {
      if (!visited.has(node.id)) {
        warnings.push({
          nodeId: node.id,
          severity: 'warning',
          message: `Step '${node.title || node.id}' is disconnected and cannot be reached from the trigger.`
        });
      }
    });
  }

  // 5. Unconnected Branch Handles Check
  safeNodes.forEach((node) => {
    const outgoing = outgoingMap.get(node.id) || [];

    if (node.type === 'CONDITION') {
      const hasTrue = outgoing.some((t) => t.sourceHandle === 'true' || t.condition === true);
      const hasFalse = outgoing.some((t) => t.sourceHandle === 'false' || t.condition === false);

      if (!hasTrue && outgoing.length === 0) {
        warnings.push({
          nodeId: node.id,
          severity: 'warning',
          message: `Condition step '${node.title || node.id}' 'True' branch has no outgoing connection.`
        });
      }
      if (!hasFalse && outgoing.length <= 1) {
        warnings.push({
          nodeId: node.id,
          severity: 'warning',
          message: `Condition step '${node.title || node.id}' 'False' branch has no outgoing connection.`
        });
      }
    }

    if ((node.type === 'SEND_MESSAGE' || node.type === 'BUTTON_MENU') && (node.config?.options || []).length > 0) {
      const options = node.config.options;
      options.forEach((opt) => {
        const hasEdge = outgoing.some((t) => t.sourceHandle === opt.id || t.optionId === opt.id);
        if (!hasEdge && outgoing.length < options.length) {
          warnings.push({
            nodeId: node.id,
            severity: 'warning',
            message: `Button '${opt.title || opt.id}' on '${node.title || node.id}' has no outgoing connection.`
          });
        }
      });
    }
  });

  // 6. Terminal Node Warning
  const terminalTypes = new Set(['END', 'HUMAN_HANDOFF', 'HANDOFF']);
  const hasTerminal = safeNodes.some((n) => terminalTypes.has(n.type));
  if (!hasTerminal && safeNodes.length > 1) {
    warnings.push({
      nodeId: null,
      severity: 'warning',
      message: 'Flow has no terminal step (e.g. End Journey or Staff Handoff). Conversations may not terminate cleanly.'
    });
  }

  return {
    isValid: errors.length === 0,
    errors,
    warnings,
    allIssues: [...errors, ...warnings]
  };
}
</file>

<file path="frontend/src/components/flow-studio/FlowVersionsModal.jsx">
import React, { useState, useEffect } from 'react';
import {
  X,
  History,
  RotateCcw,
  CheckCircle2,
  Calendar,
  UserCheck,
  AlertCircle
} from 'lucide-react';

export default function FlowVersionsModal({
  isOpen,
  onClose,
  flow,
  token,
  onRollback
}) {
  const [versions, setVersions] = useState([]);
  const [loading, setLoading] = useState(false);
  const [rollingBack, setRollingBack] = useState(false);

  useEffect(() => {
    if (!isOpen || !flow?.id) return;
    setLoading(true);
    fetch(`/api/flows/conversation-flows/${flow.id}/versions`, {
      headers: { Authorization: `Bearer ${token}` }
    })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          setVersions(data.versions || []);
        }
      })
      .catch(err => console.error('Failed to load versions:', err))
      .finally(() => setLoading(false));
  }, [isOpen, flow?.id, token]);

  if (!isOpen) return null;

  const handleRollback = async (verNumber) => {
    if (!window.confirm(`Are you sure you want to rollback to Version ${verNumber}? Current draft will be replaced with this version's snapshot.`)) {
      return;
    }
    setRollingBack(true);
    try {
      await onRollback(verNumber);
      onClose();
    } finally {
      setRollingBack(false);
    }
  };

  return (
    <div style={{
      position: 'fixed',
      inset: 0,
      background: 'rgba(0,0,0,0.5)',
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
      zIndex: 1000,
      padding: '20px'
    }}>
      <div style={{
        background: '#FFFFFF',
        borderRadius: '16px',
        width: '680px',
        maxWidth: '100%',
        maxHeight: '85vh',
        display: 'flex',
        flexDirection: 'column',
        boxShadow: '0 20px 40px rgba(0,0,0,0.2)',
        overflow: 'hidden'
      }}>
        {/* Header */}
        <div style={{
          padding: '18px 24px',
          borderBottom: '1px solid #E5E5E8',
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          background: '#FAFAFB'
        }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
            <div style={{
              width: '34px',
              height: '34px',
              borderRadius: '8px',
              background: '#F2F2F7',
              color: '#1C1C1E',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center'
            }}>
              <History size={18} />
            </div>
            <div>
              <h3 style={{ fontSize: '1.05rem', fontWeight: 700, margin: 0, color: '#1C1C1E' }}>
                Version History: {flow?.name}
              </h3>
              <div style={{ fontSize: '0.78rem', color: '#67676B' }}>
                Immutable releases, audit trail & 1-click rollback
              </div>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            style={{ border: 'none', background: 'transparent', cursor: 'pointer', color: '#8E8E93', padding: '6px' }}
          >
            <X size={18} />
          </button>
        </div>

        {/* Content */}
        <div style={{ padding: '20px', flex: 1, overflowY: 'auto' }}>
          {loading ? (
            <div style={{ textAlign: 'center', padding: '40px', color: '#8E8E93' }}>
              <RotateCcw size={24} className="spin" style={{ margin: '0 auto 10px' }} />
              <div>Loading version history...</div>
            </div>
          ) : versions.length === 0 ? (
            <div style={{ textAlign: 'center', padding: '40px', color: '#8E8E93' }}>
              No version snapshots recorded yet.
            </div>
          ) : (
            <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
              {versions.map(ver => {
                const isPublished = ver.status === 'PUBLISHED';
                return (
                  <div
                    key={ver.id}
                    style={{
                      padding: '14px 16px',
                      borderRadius: '10px',
                      border: isPublished ? '1px solid #2F5219' : '1px solid #E5E5E8',
                      background: isPublished ? '#F9FDF7' : '#FFFFFF',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'space-between',
                      gap: '12px'
                    }}
                  >
                    <div>
                      <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '4px' }}>
                        <span style={{
                          fontWeight: 700,
                          fontSize: '0.9rem',
                          color: '#1C1C1E'
                        }}>
                          Version {ver.version_number}
                        </span>
                        <span style={{
                          fontSize: '0.7rem',
                          fontWeight: 700,
                          padding: '2px 6px',
                          borderRadius: '4px',
                          background: isPublished ? '#E8F5E9' : '#F2F2F7',
                          color: isPublished ? '#2F5219' : '#67676B'
                        }}>
                          {ver.status}
                        </span>
                      </div>
                      <div style={{ fontSize: '0.78rem', color: '#48484A', marginBottom: '4px' }}>
                        {ver.changelog || 'Draft updates saved'}
                      </div>
                      <div style={{ display: 'flex', gap: '12px', fontSize: '0.72rem', color: '#8E8E93' }}>
                        <span style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                          <Calendar size={12} /> {ver.published_at || ver.created_at}
                        </span>
                        <span style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                          <UserCheck size={12} /> {ver.published_by || 'Admin'}
                        </span>
                      </div>
                    </div>

                    <button
                      type="button"
                      onClick={() => handleRollback(ver.version_number)}
                      disabled={rollingBack}
                      className="btn btn-outline"
                      style={{
                        padding: '6px 12px',
                        fontSize: '0.78rem',
                        gap: '6px'
                      }}
                    >
                      <RotateCcw size={13} />
                      <span>Rollback</span>
                    </button>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/flow-studio/MessageTemplatesStudio.jsx">
import React, { useState, useEffect } from 'react';
import {
  MessageSquare,
  Plus,
  Trash2,
  Edit2,
  Search,
  Copy,
  Check,
  Tag,
  Save,
  X,
  RotateCcw
} from 'lucide-react';

export default function MessageTemplatesStudio({ token }) {
  const [templates, setTemplates] = useState([]);
  const [loading, setLoading] = useState(false);
  const [search, setSearch] = useState('');
  const [selectedCategory, setSelectedCategory] = useState('ALL');
  const [editingTemplate, setEditingTemplate] = useState(null);
  const [saving, setSaving] = useState(false);
  const [copiedVar, setCopiedVar] = useState(null);

  const fetchTemplates = () => {
    setLoading(true);
    fetch('/api/flows/message-templates', {
      headers: { Authorization: `Bearer ${token}` }
    })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          setTemplates(data.templates || []);
        }
      })
      .catch(err => console.error('Failed to load message templates:', err))
      .finally(() => setLoading(false));
  };

  useEffect(() => {
    fetchTemplates();
  }, [token]);

  const handleCopyVar = (v) => {
    navigator.clipboard.writeText(`{{${v}}}`);
    setCopiedVar(v);
    setTimeout(() => setCopiedVar(null), 1500);
  };

  const handleSave = async () => {
    if (!editingTemplate.code || !editingTemplate.title || !editingTemplate.content) {
      alert('Code, Title, and Content are required.');
      return;
    }
    setSaving(true);
    try {
      const res = await fetch('/api/flows/message-templates', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify(editingTemplate)
      });
      const data = await res.json();
      if (data.success) {
        setEditingTemplate(null);
        fetchTemplates();
      } else {
        alert(data.error || 'Failed to save template');
      }
    } catch (e) {
      alert(e.message);
    } finally {
      setSaving(false);
    }
  };

  const handleDelete = async (id) => {
    if (!window.confirm('Delete this message template?')) return;
    try {
      const res = await fetch(`/api/flows/message-templates/${id}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        fetchTemplates();
      }
    } catch (e) {
      console.error(e);
    }
  };

  const filtered = templates.filter(t => {
    const matchCategory = selectedCategory === 'ALL' || t.category === selectedCategory;
    const matchSearch = !search || t.title.toLowerCase().includes(search.toLowerCase()) || t.code.toLowerCase().includes(search.toLowerCase()) || t.content.toLowerCase().includes(search.toLowerCase());
    return matchCategory && matchSearch;
  });

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>
      {/* Action Bar */}
      <div style={{
        display: 'flex',
        justifyContent: 'space-between',
        alignItems: 'center',
        flexWrap: 'wrap',
        gap: '12px'
      }}>
        <div style={{ display: 'flex', gap: '10px', alignItems: 'center' }}>
          <div style={{
            position: 'relative',
            width: '260px'
          }}>
            <Search size={15} style={{ position: 'absolute', left: '10px', top: '10px', color: '#8E8E93' }} />
            <input
              type="text"
              className="form-input"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Search templates..."
              style={{ paddingLeft: '32px', fontSize: '0.82rem' }}
            />
          </div>
          <div style={{ display: 'flex', gap: '4px' }}>
            {['ALL', 'WELCOME', 'QUOTE', 'ENQUIRY', 'HANDOFF', 'PROMOTION'].map(cat => (
              <button
                key={cat}
                type="button"
                onClick={() => setSelectedCategory(cat)}
                style={{
                  padding: '6px 12px',
                  borderRadius: '6px',
                  fontSize: '0.76rem',
                  fontWeight: selectedCategory === cat ? 700 : 500,
                  border: selectedCategory === cat ? '1px solid #2F5219' : '1px solid #E5E5E8',
                  background: selectedCategory === cat ? '#E8F5E9' : '#FFFFFF',
                  color: selectedCategory === cat ? '#2F5219' : '#48484A',
                  cursor: 'pointer'
                }}
              >
                {cat}
              </button>
            ))}
          </div>
        </div>

        <button
          type="button"
          onClick={() => setEditingTemplate({
            code: `TPL_${Date.now().toString(36).toUpperCase()}`,
            title: '',
            category: 'CONVERSATION',
            content: '',
            variables: ['property.name', 'guest_name'],
            buttons: []
          })}
          className="btn btn-primary"
          style={{
            background: '#2F5219',
            borderColor: '#2F5219',
            fontSize: '0.82rem',
            padding: '7px 14px',
            gap: '6px'
          }}
        >
          <Plus size={15} />
          <span>New Message Template</span>
        </button>
      </div>

      {/* Grid of Templates */}
      {loading ? (
        <div style={{ textAlign: 'center', padding: '40px', color: '#8E8E93' }}>
          <RotateCcw size={22} className="spin" style={{ margin: '0 auto 8px' }} />
          <div>Loading message templates...</div>
        </div>
      ) : filtered.length === 0 ? (
        <div style={{
          textAlign: 'center',
          padding: '40px',
          background: '#FAFAFB',
          borderRadius: '12px',
          border: '1px dashed #D1D1D6'
        }}>
          <MessageSquare size={32} style={{ color: '#8E8E93', margin: '0 auto 10px' }} />
          <div style={{ fontSize: '0.9rem', fontWeight: 600, color: '#1C1C1E' }}>No message templates found</div>
          <div style={{ fontSize: '0.78rem', color: '#67676B', marginTop: '4px' }}>
            Create reusable messages with dynamic variable slots to use across all conversation nodes.
          </div>
        </div>
      ) : (
        <div style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fill, minmax(340px, 1fr))',
          gap: '16px'
        }}>
          {filtered.map(tpl => (
            <div
              key={tpl.id}
              style={{
                background: '#FFFFFF',
                borderRadius: '12px',
                border: '1px solid #E5E5E8',
                padding: '16px',
                boxShadow: '0 2px 6px rgba(0,0,0,0.02)',
                display: 'flex',
                flexDirection: 'column',
                justifyContent: 'space-between'
              }}
            >
              <div>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '8px' }}>
                  <span style={{
                    fontSize: '0.7rem',
                    fontWeight: 700,
                    padding: '2px 8px',
                    borderRadius: '4px',
                    background: '#F2F2F7',
                    color: '#2F5219'
                  }}>
                    {tpl.category}
                  </span>
                  <span style={{ fontSize: '0.72rem', color: '#8E8E93', fontFamily: 'monospace' }}>
                    {tpl.code}
                  </span>
                </div>
                <h4 style={{ fontSize: '0.92rem', fontWeight: 700, margin: '0 0 8px 0', color: '#1C1C1E' }}>
                  {tpl.title}
                </h4>
                <div style={{
                  fontSize: '0.8rem',
                  color: '#48484A',
                  background: '#F9F9FB',
                  padding: '10px',
                  borderRadius: '8px',
                  border: '1px solid #EFEFEF',
                  whiteSpace: 'pre-wrap',
                  lineHeight: '1.45',
                  maxHeight: '120px',
                  overflowY: 'auto'
                }}>
                  {tpl.content}
                </div>

                {/* Variables Chips */}
                {tpl.variables?.length > 0 && (
                  <div style={{ display: 'flex', flexWrap: 'wrap', gap: '6px', marginTop: '10px' }}>
                    {tpl.variables.map(v => (
                      <button
                        key={v}
                        type="button"
                        onClick={() => handleCopyVar(v)}
                        title="Click to copy variable syntax"
                        style={{
                          fontSize: '0.7rem',
                          background: '#EAEAEF',
                          color: '#2F5219',
                          border: 'none',
                          borderRadius: '4px',
                          padding: '2px 6px',
                          cursor: 'pointer',
                          display: 'flex',
                          alignItems: 'center',
                          gap: '4px'
                        }}
                      >
                        {copiedVar === v ? <Check size={11} color="#2F5219" /> : <Copy size={11} />}
                        <span>{`{{${v}}}`}</span>
                      </button>
                    ))}
                  </div>
                )}
              </div>

              <div style={{
                marginTop: '14px',
                paddingTop: '10px',
                borderTop: '1px solid #F2F2F7',
                display: 'flex',
                justifyContent: 'flex-end',
                gap: '8px'
              }}>
                <button
                  type="button"
                  onClick={() => setEditingTemplate(tpl)}
                  className="btn btn-outline"
                  style={{ padding: '4px 10px', fontSize: '0.75rem', gap: '4px' }}
                >
                  <Edit2 size={13} /> Edit
                </button>
                <button
                  type="button"
                  onClick={() => handleDelete(tpl.id)}
                  style={{
                    border: 'none',
                    background: 'transparent',
                    color: '#DC2626',
                    cursor: 'pointer',
                    padding: '4px 8px',
                    fontSize: '0.75rem'
                  }}
                >
                  <Trash2 size={14} />
                </button>
              </div>
            </div>
          ))}
        </div>
      )}

      {/* Edit/Create Modal */}
      {editingTemplate && (
        <div style={{
          position: 'fixed',
          inset: 0,
          background: 'rgba(0,0,0,0.5)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 1000,
          padding: '20px'
        }}>
          <div style={{
            background: '#FFFFFF',
            borderRadius: '16px',
            width: '560px',
            maxWidth: '100%',
            padding: '24px',
            boxShadow: '0 20px 40px rgba(0,0,0,0.2)',
            display: 'flex',
            flexDirection: 'column',
            gap: '14px'
          }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <h3 style={{ fontSize: '1.05rem', fontWeight: 700, margin: 0 }}>
                {editingTemplate.id ? 'Edit Message Template' : 'New Message Template'}
              </h3>
              <button
                type="button"
                onClick={() => setEditingTemplate(null)}
                style={{ border: 'none', background: 'transparent', cursor: 'pointer', color: '#8E8E93' }}
              >
                <X size={18} />
              </button>
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '12px' }}>
              <div>
                <label className="form-label" style={{ fontWeight: 600, fontSize: '0.8rem' }}>Unique Code</label>
                <input
                  type="text"
                  className="form-input"
                  value={editingTemplate.code || ''}
                  onChange={(e) => setEditingTemplate({ ...editingTemplate, code: e.target.value.toUpperCase() })}
                  placeholder="e.g. WELCOME_VILLA"
                  disabled={Boolean(editingTemplate.id)}
                />
              </div>
              <div>
                <label className="form-label" style={{ fontWeight: 600, fontSize: '0.8rem' }}>Category</label>
                <select
                  className="form-input"
                  value={editingTemplate.category || 'CONVERSATION'}
                  onChange={(e) => setEditingTemplate({ ...editingTemplate, category: e.target.value })}
                >
                  <option value="WELCOME">WELCOME</option>
                  <option value="QUOTE">QUOTE</option>
                  <option value="ENQUIRY">ENQUIRY</option>
                  <option value="HANDOFF">HANDOFF</option>
                  <option value="PROMOTION">PROMOTION</option>
                  <option value="CONVERSATION">CONVERSATION</option>
                </select>
              </div>
            </div>

            <div>
              <label className="form-label" style={{ fontWeight: 600, fontSize: '0.8rem' }}>Template Title</label>
              <input
                type="text"
                className="form-input"
                value={editingTemplate.title || ''}
                onChange={(e) => setEditingTemplate({ ...editingTemplate, title: e.target.value })}
                placeholder="e.g. Beach Resort Welcome Greeting"
              />
            </div>

            <div>
              <label className="form-label" style={{ fontWeight: 600, fontSize: '0.8rem' }}>Message Body</label>
              <textarea
                className="form-input"
                rows={5}
                value={editingTemplate.content || ''}
                onChange={(e) => setEditingTemplate({ ...editingTemplate, content: e.target.value })}
                placeholder="Use {{variables}} for dynamic interpolation..."
              />
            </div>

            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '10px', marginTop: '10px' }}>
              <button
                type="button"
                onClick={() => setEditingTemplate(null)}
                className="btn btn-outline"
                style={{ padding: '8px 16px' }}
              >
                Cancel
              </button>
              <button
                type="button"
                onClick={handleSave}
                disabled={saving}
                className="btn btn-primary"
                style={{
                  padding: '8px 18px',
                  background: '#2F5219',
                  borderColor: '#2F5219',
                  fontWeight: 600,
                  gap: '6px'
                }}
              >
                {saving ? <RotateCcw size={15} className="spin" /> : <Save size={15} />}
                <span>Save Template</span>
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

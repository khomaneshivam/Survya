                      >
                        <option value="NONE">None / Complete journey</option>
                        {nodes.filter(n => n.id !== node.id).map(targetNode => (
                          <option key={targetNode.id} value={targetNode.id}>
                            ➔ {targetNode.title} ({targetNode.type})
                          </option>
                        ))}
                      </select>
                    </div>

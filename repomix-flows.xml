                                  padding: '6px 10px',
                                  borderRadius: '6px',
                                  background: '#2876B8',
                                  border: 'none',
                                  color: '#FFFFFF',
                                  fontSize: '0.78rem',
                                  fontWeight: 600,
                                  cursor: 'pointer'
                                }}

  const [loading, setLoading] = useState(false);

  useEffect(() => {
    if (!flowId) return;
    setLoading(true);
    fetch(`/api/flows/conversation-flows/${flowId}/analytics`, {
      headers: { Authorization: `Bearer ${token}` }
    })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          setAnalytics(data.analytics);
        }

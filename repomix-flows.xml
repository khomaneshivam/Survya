              </>
            )}

            {/* 6. CONDITION & BRANCHING */}
            {isCondition && (
              <>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                  <label className="form-label" style={{ fontWeight: 600, fontSize: '0.80rem', margin: 0 }}>

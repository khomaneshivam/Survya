<file path="src/services/workflow/expressionEvaluator.js">
/**
 * Safe, zero-eval Expression & Template Engine for SARVYA Workflow Execution
 * Provides safe dot-path variable resolution, template interpolation, deterministic
 * condition rule evaluation (ALL/ANY with 13 operators), and variable mutations.
 */

/**
 * Safely resolves a dot-separated path from context.
 * Falls back to checking sub-namespaces (session, contact, crm, catalog, trigger)
 * so {{name}} and {{contact.name}} both resolve gracefully.
 */
function getPath(context, path) {
  if (!context || typeof context !== 'object' || !path || typeof path !== 'string') {
    return undefined;
  }

  const cleanPath = path.trim();
  if (!cleanPath) return undefined;

  // Direct dot traversal
  const parts = cleanPath.split('.');
  let curr = context;
  let found = true;

  for (const part of parts) {
    if (curr == null || typeof curr !== 'object' || !(part in curr)) {
      found = false;
      break;
    }
    curr = curr[part];
  }

  if (found && curr !== undefined) {
    return curr;
  }

  // Fallback checks inside standard SARVYA namespaces if top-level lookup missed
  const namespaces = ['session', 'contact', 'crm', 'catalog', 'trigger', 'api'];
  for (const ns of namespaces) {
    if (context[ns] && typeof context[ns] === 'object' && cleanPath in context[ns]) {
      return context[ns][cleanPath];
    }
  }

  return undefined;
}

/**
 * Interpolates {{variable}} or {{dot.path}} placeholders within a template string.
 * Preserves empty string if variable is undefined/null.
 */
function interpolateTemplate(templateStr, context = {}) {
  if (!templateStr || typeof templateStr !== 'string') return '';
  return templateStr.replace(/\{\{\s*([a-zA-Z0-9_.-]+)\s*\}\}/g, (_match, path) => {
    const val = getPath(context, path);
    if (val === undefined || val === null) return '';
    if (typeof val === 'object') return JSON.stringify(val);
    return String(val);
  });
}

/**
 * Deterministic condition rule evaluator.
 * Evaluates an array of rules against a context object using ALL (AND) or ANY (OR).
 */
function evaluateRules(rules = [], matchMode = 'ALL', context = {}) {
  if (!Array.isArray(rules) || rules.length === 0) {
    return true; // Empty rule list defaults to true
  }

  const isAny = String(matchMode).toUpperCase() === 'ANY';

  for (const rule of rules) {
    const { variable, operator, value } = rule;
    const actualVal = getPath(context, variable);
    const expectedVal = typeof value === 'string' ? interpolateTemplate(value, context) : value;

    const passes = evaluateSingleRule(actualVal, operator, expectedVal);

    if (isAny && passes) {
      return true;
    }
    if (!isAny && !passes) {
      return false;
    }
  }

  return !isAny;
}

/**
 * Evaluates a single comparison rule with automatic numeric coercion where appropriate.
 */
function evaluateSingleRule(actual, op, expected) {
  const normOp = String(op || 'eq').toLowerCase().trim();

  // Special existence operators
  if (normOp === 'is_empty') {
    if (actual === null || actual === undefined) return true;
    if (typeof actual === 'string') return actual.trim().length === 0;
    if (Array.isArray(actual)) return actual.length === 0;
    if (typeof actual === 'object') return Object.keys(actual).length === 0;
    return false;
  }
  if (normOp === 'is_not_empty') {
    return !evaluateSingleRule(actual, 'is_empty', expected);
  }

  // Coerce actual/expected to numbers if both represent valid numeric values
  const actualNum = Number(actual);
  const expectedNum = Number(expected);
  const bothNumeric = !isNaN(actualNum) && !isNaN(expectedNum) && actual !== '' && expected !== '' && actual !== null && expected !== null;

  switch (normOp) {
    case 'eq':
    case '==':
    case 'equal':
    case 'equals':
      if (bothNumeric) return actualNum === expectedNum;
      return String(actual ?? '').toLowerCase().trim() === String(expected ?? '').toLowerCase().trim();

    case 'neq':
    case '!=':
    case 'not_equal':
    case 'not_equals':
      if (bothNumeric) return actualNum !== expectedNum;
      return String(actual ?? '').toLowerCase().trim() !== String(expected ?? '').toLowerCase().trim();

    case 'gt':
    case '>':
    case 'greater_than':
      return bothNumeric && actualNum > expectedNum;

    case 'gte':
    case '>=':
    case 'greater_than_or_equal':
    case 'greater_than_or_equals':
      return bothNumeric && actualNum >= expectedNum;

    case 'lt':
    case '<':
    case 'less_than':
      return bothNumeric && actualNum < expectedNum;

    case 'lte':
    case '<=':
    case 'less_than_or_equal':
    case 'less_than_or_equals':
      return bothNumeric && actualNum <= expectedNum;

    case 'contains': {
      if (Array.isArray(actual)) {
        return actual.some(item => String(item).toLowerCase() === String(expected).toLowerCase());
      }
      return String(actual ?? '').toLowerCase().includes(String(expected ?? '').toLowerCase());
    }

    case 'not_contains': {
      return !evaluateSingleRule(actual, 'contains', expected);
    }

    case 'in': {
      const list = Array.isArray(expected)
        ? expected
        : String(expected ?? '').split(',').map(s => s.trim().toLowerCase());
      return list.includes(String(actual ?? '').trim().toLowerCase());
    }

    case 'not_in': {
      return !evaluateSingleRule(actual, 'in', expected);
    }

    case 'regex': {
      try {
        const regex = new RegExp(String(expected), 'i');
        return regex.test(String(actual ?? ''));
      } catch (e) {
        return false;
      }
    }

    default:
      return false;
  }
}

/**
 * Computes variable mutation based on operation.
 * Supports both (op, currentVal, value) and (currentVal, op, value).
 */
function computeVariable(arg1, arg2, arg3, context = {}) {
  let op, currentVal, value;
  const knownOps = ['set', 'increment', 'add', 'decrement', 'subtract', 'append_tag', 'concat', 'clear'];
  if (typeof arg1 === 'string' && knownOps.includes(arg1.toLowerCase().trim())) {
    op = arg1;
    currentVal = arg2;
    value = arg3;
  } else {
    currentVal = arg1;
    op = arg2;
    value = arg3;
  }

  const normOp = String(op || 'set').toLowerCase().trim();
  const resolvedVal = typeof value === 'string' ? interpolateTemplate(value, context) : value;

  switch (normOp) {
    case 'set':
      // If resolvedVal looks like a pure integer/number, cast it
      if (typeof resolvedVal === 'string' && /^-?\d+(\.\d+)?$/.test(resolvedVal.trim())) {
        return Number(resolvedVal.trim());
      }
      return resolvedVal;

    case 'increment':
    case 'add': {
      const cur = Number(currentVal) || 0;
      const add = Number(resolvedVal) || 0;
      return cur + add;
    }

    case 'decrement':
    case 'subtract': {
      const cur = Number(currentVal) || 0;
      const sub = Number(resolvedVal) || 0;
      return cur - sub;
    }

    case 'append_tag': {
      let tags = [];
      if (Array.isArray(currentVal)) {
        tags = [...currentVal];
      } else if (typeof currentVal === 'string' && currentVal.trim()) {
        tags = currentVal.split(',').map(s => s.trim());
      }
      const newTags = String(resolvedVal).split(',').map(s => s.trim()).filter(Boolean);
      for (const t of newTags) {
        if (!tags.includes(t)) tags.push(t);
      }
      return tags;
    }

    case 'concat': {
      return `${String(currentVal ?? '')}${String(resolvedVal ?? '')}`;
    }

    case 'clear':
      return null;

    default:
      return resolvedVal;
  }
}

module.exports = {
  getPath,
  interpolateTemplate,
  evaluateRules,
  evaluateSingleRule,
  computeVariable
};
</file>

<file path="src/services/workflow/workflowTriggerService.js">
const crypto = require("crypto");
const { db } = require("../../config/database");

/**
 * Workflow Trigger Service
 * Manages trigger indexing on flow publish, inbound trigger matching, and external webhook execution.
 */
class WorkflowTriggerService {
  /**
   * Syncs and indexes triggers for a published flow.
   * Scans nodes for TRIGGER_WHATSAPP, TRIGGER_EVENT, and START nodes.
   */
  syncFlowTriggers(tenantId = 1, flowId, nodes = []) {
    if (!flowId || !Array.isArray(nodes)) return;

    // Remove existing triggers for this flow
    db.prepare(`
      DELETE FROM workflow_triggers
      WHERE tenant_id = ? AND flow_id = ?
    `).run(Number(tenantId) || 1, String(flowId));

    const insertStmt = db.prepare(`
      INSERT INTO workflow_triggers (
        tenant_id, flow_id, trigger_key, trigger_type, match_config_json,
        secret_token, priority, active_status, delete_status, created_at, updated_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, 1, 0, NOW(), NOW())
    `);

    for (const node of nodes) {
      const type = node.type;
      const data = node.data || {};

      if (type === "TRIGGER_WHATSAPP" || type === "START") {
        const triggerType = data.triggerType || "KEYWORD";
        const rawKeywords = data.keywords || (data.keyword ? [data.keyword] : []);
        const keywords = Array.isArray(rawKeywords)
          ? rawKeywords.map(k => String(k).trim()).filter(Boolean)
          : String(rawKeywords || "").split(",").map(k => k.trim()).filter(Boolean);

        const matchType = data.matchType || "CONTAINS"; // EXACT, CONTAINS, REGEX
        const triggerKey = data.triggerKey || `trg_${flowId}_${node.id}`.replace(/[^a-zA-Z0-9_]/g, "_");

        const configJson = JSON.stringify({
          nodeId: node.id,
          nodeType: type,
          keywords,
          matchType,
          ignoreCase: data.ignoreCase !== false,
          priority: data.priority || 100
        });

        insertStmt.run(
          Number(tenantId) || 1,
          String(flowId),
          triggerKey,
          triggerType,
          configJson,
          null,
          data.priority || 100
        );
      } else if (type === "TRIGGER_EVENT") {
        const eventType = data.eventType || "WEBHOOK";
        const triggerKey = data.triggerKey || `hook_${flowId}_${node.id}`.replace(/[^a-zA-Z0-9_]/g, "_");
        const secret = data.secretToken || data.webhookSecret || crypto.randomBytes(16).toString("hex");

        const configJson = JSON.stringify({
          nodeId: node.id,
          nodeType: type,
          eventType,
          eventName: data.eventName || "incoming_event",
          payloadMapping: data.payloadMapping || {},
          fieldMappings: data.fieldMappings || {}
        });

        insertStmt.run(
          Number(tenantId) || 1,
          String(flowId),
          triggerKey,
          eventType,
          configJson,
          secret,
          data.priority || 50
        );
      }
    }
  }

  /**
   * Deactivates all triggers for an unpublished/paused/archived flow.
   */
  deactivateFlowTriggers(tenantId = 1, flowId) {
    if (!flowId) return;
    db.prepare(`
      UPDATE workflow_triggers
      SET active_status = 0, updated_at = NOW()
      WHERE tenant_id = ? AND flow_id = ?
    `).run(Number(tenantId) || 1, String(flowId));
  }

  /**
   * Matches inbound message text against registered active triggers.
   * Returns { flowId, nodeId, triggerKey, triggerType } or null.
   */
  matchInboundTrigger(tenantId = 1, { text = "", phone = "", event = null } = {}) {
    const rawTriggers = db.prepare(`
      SELECT t.*, f.status as flow_status
      FROM workflow_triggers t
      LEFT JOIN conversation_flows f ON t.flow_id = f.id
      WHERE t.tenant_id = ? 
        AND t.active_status = 1 
        AND t.delete_status = 0
        AND (f.status IS NULL OR f.status = 'PUBLISHED')
      ORDER BY t.priority ASC, t.id ASC
    `).all(Number(tenantId) || 1);

    if (!rawTriggers || rawTriggers.length === 0) return null;

    const normalizedText = String(text || "").trim();

    for (const trg of rawTriggers) {
      let config = {};
      try {
        config = JSON.parse(trg.match_config_json || "{}");
      } catch (e) {
        continue;
      }

      if (trg.trigger_type === "KEYWORD" || trg.trigger_type === "INBOUND_MESSAGE") {
        const keywords = config.keywords || [];
        if (!keywords || keywords.length === 0) {
          // Empty keywords on a START node can act as default catch-all if explicitly configured
          if (config.nodeType === "START" && config.isCatchAll) {
            return {
              flowId: trg.flow_id,
              nodeId: config.nodeId,
              triggerKey: trg.trigger_key,
              triggerType: trg.trigger_type
            };
          }
          continue;
        }

        const matchType = config.matchType || "CONTAINS";
        const ignoreCase = config.ignoreCase !== false;
        const testStr = ignoreCase ? normalizedText.toLowerCase() : normalizedText;

        for (const kw of keywords) {
          const targetKw = ignoreCase ? String(kw).toLowerCase().trim() : String(kw).trim();
          if (!targetKw) continue;

          let isMatch = false;
          if (matchType === "EXACT") {
            isMatch = (testStr === targetKw);
          } else if (matchType === "REGEX") {
            try {
              const regex = new RegExp(targetKw, ignoreCase ? "i" : "");
              isMatch = regex.test(normalizedText);
            } catch (e) {
              isMatch = false;
            }
          } else {
            // Default: CONTAINS
            isMatch = testStr.includes(targetKw);
          }

          if (isMatch) {
            return {
              flowId: trg.flow_id,
              nodeId: config.nodeId,
              triggerKey: trg.trigger_key,
              triggerType: trg.trigger_type,
              matchedKeyword: kw
            };
          }
        }
      } else if (trg.trigger_type === "EVENT" && event) {
        if (config.eventName && config.eventName === event) {
          return {
            flowId: trg.flow_id,
            nodeId: config.nodeId,
            triggerKey: trg.trigger_key,
            triggerType: trg.trigger_type
          };
        }
      }
    }

    return null;
  }

  /**
   * Executes an external webhook trigger by triggerKey.
   * POST /api/v1/workflows/hooks/:triggerKey
   */
  async executeWebhookTrigger(triggerKey, payload = {}, headers = {}) {
    if (!triggerKey) {
      return { success: false, statusCode: 400, message: "Missing triggerKey parameter" };
    }

    const trg = db.prepare(`
      SELECT t.*, f.status as flow_status
      FROM workflow_triggers t
      LEFT JOIN conversation_flows f ON t.flow_id = f.id
      WHERE t.trigger_key = ? 
        AND t.active_status = 1 
        AND t.delete_status = 0
      LIMIT 1
    `).get(String(triggerKey));

    if (!trg || (trg.flow_status && trg.flow_status !== 'PUBLISHED')) {
      return {
        success: false,
        statusCode: 404,
        message: "Trigger key not found, inactive, or flow is not published"
      };
    }

    // Verify secret token if configured
    if (trg.secret_token) {
      const providedSecret = headers["x-webhook-secret"] ||
                             headers["authorization"]?.replace(/^Bearer\s+/i, "") ||
                             payload.secret ||
                             payload.secret_token;
      if (!providedSecret || providedSecret !== trg.secret_token) {
        return {
          success: false,
          statusCode: 401,
          message: "Unauthorized: Invalid or missing webhook secret"
        };
      }
    }

    let config = {};
    try {
      config = JSON.parse(trg.match_config_json || "{}");
    } catch (e) {
      config = {};
    }

    // Extract recipient phone number
    const rawPhone = payload.phone ||
                     payload.to ||
                     payload.recipient ||
                     payload.customer_phone ||
                     payload.contact?.phone ||
                     payload.data?.phone;

    if (!rawPhone) {
      return {
        success: false,
        statusCode: 400,
        message: "Missing recipient phone in payload (expected 'phone', 'to', or 'customer_phone')"
      };
    }

    const cleanPhone = String(rawPhone).replace(/\D/g, "");
    if (!cleanPhone || cleanPhone.length < 8) {
      return {
        success: false,
        statusCode: 400,
        message: "Invalid recipient phone number format"
      };
    }

    const conversationFlowEngine = require("../conversationFlowEngine");

    // Process turn starting at target trigger node
    const result = await conversationFlowEngine.processTurn({
      senderPhone: cleanPhone,
      userInput: payload.text || payload.message || "[Trigger Event: Inbound Webhook]",
      userPayload: payload,
      startFlowId: trg.flow_id,
      startNodeId: config.nodeId,
      context: {
        tenantId: trg.tenant_id,
        channel: "WEBHOOK",
        triggerKey: trg.trigger_key,
        externalPayload: payload,
        isSimulation: Boolean(payload.isSimulation)
      }
    });

    return {
      success: true,
      statusCode: 200,
      flowId: trg.flow_id,
      nodeId: config.nodeId,
      recipientPhone: cleanPhone,
      sessionId: result?.sessionId || null,
      replyText: result?.replyText || null,
      replyInteractive: result?.replyInteractive || null
    };
  }
}

module.exports = new WorkflowTriggerService();
</file>

<file path="frontend/src/components/flow-studio/CustomFlowNode.jsx">
import React, { memo } from 'react';
import { Handle, Position } from '@xyflow/react';
import {
  Copy,
  Trash2,
  AlertCircle,
  AlertTriangle,
  CheckCircle2,
  PhoneCall
} from 'lucide-react';
import { getNodeDefinition } from './nodeDefinitions';

function CustomFlowNodeComponent({ id, data, selected }) {
  const nodeDef = getNodeDefinition(data?.type);
  const Icon = nodeDef.icon;
  const isTrigger = ['START', 'TRIGGER_WHATSAPP', 'TRIGGER_EVENT'].includes(data?.type);
  const isTerminal = ['END', 'HUMAN_HANDOFF', 'HANDOFF'].includes(data?.type);
  const isSimulatedActive = data?.activeSimulatedNodeId === id;

  const validationIssues = data?.validationIssues || [];
  const hasError = validationIssues.some(i => i.severity === 'error');
  const hasWarning = validationIssues.some(i => i.severity === 'warning');

  const handles = nodeDef.getOutputHandles ? nodeDef.getOutputHandles(data) : [];
  const hasMultipleHandles = handles.length > 1;

  // Extract a 2-line preview of node content
  const renderPreview = () => {
    const config = data?.config || {};
    const type = data?.type;

    if (type === 'TRIGGER_WHATSAPP') {
      const kw = config.keywords || [];
      return `Keywords: ${kw.slice(0, 3).join(', ')}${kw.length > 3 ? '...' : ''}`;
    }
    if (type === 'TRIGGER_EVENT') {
      return `Event: ${config.eventName || 'lifecycle_event'}`;
    }
    if (type === 'SEND_MESSAGE' || type === 'MESSAGE') {
      if (config.text) {
        return config.text.length > 65 ? `${config.text.substring(0, 65)}...` : config.text;
      }
      return `${(config.options || []).length} interactive buttons`;
    }
    if (type === 'SEND_TEMPLATE') {
      return `Template: ${config.templateName || 'unnamed'}`;
    }
    if (type === 'SEND_WHATSAPP_FLOW') {
      return `Meta Flow ID: ${config.metaFlowId || 'unassigned'}`;
    }
    if (type === 'COLLECT_INPUT' || type === 'INPUT_COLLECTION' || type === 'QUESTION') {
      return `Collects {{${config.saveAs || config.variable || 'input'}}}`;
    }
    if (type === 'CONDITION') {
      const rules = config.rules || [];
      if (rules.length > 0) {
        const r = rules[0];
        return `If {{${r.variable || 'var'}}} ${r.operator || 'eq'} "${r.value || ''}"`;
      }
      return 'Branch evaluation rules';
    }
    if (type === 'SET_VARIABLE') {
      return `${config.operation || 'SET'} {{${config.targetVar || 'var'}}} = "${config.value || ''}"`;
    }
    if (type === 'WAIT_DELAY') {
      return `Wait ${config.durationValue || 2} ${String(config.durationUnit || 'HOURS').toLowerCase()}`;
    }
    if (type === 'CRM_UPSERT') {
      return `Stage: ${config.stage || 'QUALIFIED'}`;
    }
    if (type === 'CATALOG_BOOKING' || type === 'BUSINESS_ACTION') {
      return `Action: ${(config.action || 'Availability').replace('HOSPITALITY_', '')}`;
    }
    if (type === 'HTTP_WEBHOOK' || type === 'API_INTEGRATION') {
      return `${config.method || 'POST'} ${config.url || 'endpoint'}`;
    }
    if (type === 'HUMAN_HANDOFF' || type === 'HANDOFF') {
      return `Handoff to: ${config.team || 'FRONT_DESK'}`;
    }
    if (type === 'END') {
      return config.farewellMessage ? `${config.farewellMessage.substring(0, 50)}...` : 'Journey Completed';
    }

    return 'Workflow Step';
  };

  const handleDuplicate = (e) => {
    e.stopPropagation();
    data?.onDuplicateNode?.(id);
  };

  const handleDelete = (e) => {
    e.stopPropagation();
    data?.onDeleteNode?.(id);
  };

  // Card border and shadow
  let borderColor = '#E5E5E8';
  let boxShadow = '0 2px 8px rgba(0,0,0,0.04)';

  if (selected) {
    borderColor = nodeDef.color || '#2F5219';
    boxShadow = `0 6px 18px rgba(0,0,0,0.08), 0 0 0 2px ${nodeDef.bg || '#E8F5E9'}`;
  }

  if (isSimulatedActive) {
    borderColor = '#2F5219';
    boxShadow = '0 0 0 3px #2F5219, 0 0 16px rgba(47,82,25,0.45)';
  } else if (hasError) {
    borderColor = '#EF4444';
  } else if (hasWarning && !selected) {
    borderColor = '#F59E0B';
  }

  return (
    <div
      style={{
        width: '270px',
        background: '#FFFFFF',
        borderRadius: '10px',
        border: `1.5px solid ${borderColor}`,
        boxShadow,
        position: 'relative',
        transition: 'all 0.15s ease',
        cursor: 'pointer',
        fontSize: '0.80rem'
      }}
    >
      {/* Top Input Connection Port (omitted for triggers) */}
      {!isTrigger && (
        <Handle
          type="target"
          position={Position.Top}
          id="target"
          style={{
            top: '-5px',
            background: '#94A3B8',
            width: '10px',
            height: '10px',
            border: '2px solid #FFFFFF',
            zIndex: 10
          }}
        />
      )}

      {/* Top Category Strip */}
      <div
        style={{
          height: '4px',
          background: nodeDef.color,
          borderRadius: '8px 8px 0 0'
        }}
      />

      {/* Card Header */}
      <div
        style={{
          padding: '8px 12px',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          borderBottom: '1px solid #F1F5F9',
          background: selected ? nodeDef.bg : '#FAFAFB'
        }}
      >
        <div style={{ display: 'flex', alignItems: 'center', gap: '8px', minWidth: 0 }}>
          <div
            style={{
              width: '24px',
              height: '24px',
              borderRadius: '6px',
              background: nodeDef.bg,
              color: nodeDef.color,
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              flexShrink: 0
            }}
          >
            <Icon size={14} />
          </div>
          <div style={{ minWidth: 0 }}>
            <span
              style={{
                fontSize: '0.68rem',
                fontWeight: 700,
                color: nodeDef.color,
                letterSpacing: '0.04em',
                textTransform: 'uppercase'
              }}
            >
              {nodeDef.badge || nodeDef.label}
            </span>
          </div>
        </div>

        {/* Action icons & validation status */}
        <div style={{ display: 'flex', alignItems: 'center', gap: '4px', flexShrink: 0 }}>
          {hasError && (
            <span title={validationIssues.map(i => i.message).join('\n')} style={{ color: '#EF4444', display: 'flex' }}>
              <AlertCircle size={14} />
            </span>
          )}
          {!hasError && hasWarning && (
            <span title={validationIssues.map(i => i.message).join('\n')} style={{ color: '#F59E0B', display: 'flex' }}>
              <AlertTriangle size={14} />
            </span>
          )}

          <button
            type="button"
            onClick={handleDuplicate}
            title="Duplicate step"
            style={{
              border: 'none',
              background: 'transparent',
              color: '#94A3B8',
              cursor: 'pointer',
              padding: '2px',
              display: 'flex',
              alignItems: 'center'
            }}
          >
            <Copy size={12} />
          </button>

          {!isTrigger && (
            <button
              type="button"
              onClick={handleDelete}
              title="Delete step"
              style={{
                border: 'none',
                background: 'transparent',
                color: '#EF4444',
                cursor: 'pointer',
                padding: '2px',
                display: 'flex',
                alignItems: 'center'
              }}
            >
              <Trash2 size={12} />
            </button>
          )}
        </div>
      </div>

      {/* Card Body */}
      <div style={{ padding: '10px 12px' }}>
        <div
          style={{
            fontWeight: 700,
            color: '#1C1C1E',
            marginBottom: '4px',
            fontSize: '0.84rem',
            overflow: 'hidden',
            textOverflow: 'ellipsis',
            whiteSpace: 'nowrap'
          }}
        >
          {data?.title || nodeDef.label}
        </div>
        <div
          style={{
            fontSize: '0.74rem',
            color: '#64748B',
            lineHeight: '1.4',
            minHeight: '28px',
            wordBreak: 'break-word'
          }}
        >
          {renderPreview()}
        </div>

        {/* Dynamic Branch Handle Rows (for nodes with multiple outputs like buttons, conditions) */}
        {hasMultipleHandles && (
          <div style={{ marginTop: '8px', display: 'flex', flexDirection: 'column', gap: '5px' }}>
            {handles.map((h) => (
              <div
                key={h.id}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  padding: '4px 8px',
                  background: '#F8FAFC',
                  borderRadius: '5px',
                  border: '1px solid #E2E8F0',
                  position: 'relative'
                }}
              >
                <span
                  style={{
                    fontSize: '0.72rem',
                    fontWeight: 600,
                    color: h.color || '#334155',
                    overflow: 'hidden',
                    textOverflow: 'ellipsis',
                    whiteSpace: 'nowrap',
                    maxWidth: '210px'
                  }}
                >
                  {h.label}
                </span>

                {/* Right-aligned handle for each option */}
                <Handle
                  type="source"
                  position={Position.Right}
                  id={h.id}
                  style={{
                    top: '50%',
                    transform: 'translateY(-50%)',
                    right: '-5px',
                    background: h.color || nodeDef.color,
                    width: '9px',
                    height: '9px',
                    border: '2px solid #FFFFFF',
                    zIndex: 10
                  }}
                />
              </div>
            ))}
          </div>
        )}

        {/* Terminal Badge for End & Handoff nodes */}
        {isTerminal && (
          <div
            style={{
              marginTop: '6px',
              padding: '4px 8px',
              borderRadius: '5px',
              background: data?.type === 'END' ? '#F1F5F9' : '#FFF1F2',
              color: data?.type === 'END' ? '#475569' : '#BE123C',
              fontSize: '0.70rem',
              fontWeight: 600,
              display: 'flex',
              alignItems: 'center',
              gap: '6px'
            }}
          >
            {data?.type === 'END' ? <CheckCircle2 size={12} /> : <PhoneCall size={12} />}
            <span>{data?.type === 'END' ? 'Terminal End Point' : 'Transfers to Live Agent'}</span>
          </div>
        )}

        {/* Live Visual Analytics Overlay (Entered & Drop-off Rate) */}
        {data?.showAnalyticsOverlay && (
          <div
            style={{
              marginTop: '8px',
              padding: '6px 8px',
              background: '#F0FDF4',
              border: '1px solid #BBF7D0',
              borderRadius: '6px',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              fontSize: '0.68rem',
              fontWeight: 600,
              color: '#166534'
            }}
          >
            <div style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
              <span style={{ color: '#15803D' }}>●</span>
              <span>Entered: <strong>{data.metrics?.entered ?? 0}</strong></span>
            </div>
            <div
              style={{
                color: (data.metrics?.dropoffRate || 0) > 30 ? '#DC2626' : '#15803D',
                background: (data.metrics?.dropoffRate || 0) > 30 ? '#FEE2E2' : '#DCFCE7',
                padding: '2px 6px',
                borderRadius: '4px'
              }}
            >
              Drop-off: {data.metrics?.dropoffRate ?? 0}%
            </div>
          </div>
        )}
      </div>

      {/* Single Output Handle at Bottom Center for single-output nodes */}
      {!isTerminal && !hasMultipleHandles && (
        <Handle
          type="source"
          position={Position.Bottom}
          id={handles[0]?.id || 'default'}
          style={{
            bottom: '-5px',
            background: handles[0]?.color || nodeDef.color,
            width: '10px',
            height: '10px',
            border: '2px solid #FFFFFF',
            zIndex: 10
          }}
        />
      )}
    </div>
  );
}

export default memo(CustomFlowNodeComponent);
</file>

<file path="frontend/src/components/flow-studio/FlowExecutionsModal.jsx">
import React, { useState, useEffect, useCallback } from 'react';
import {
  X,
  History,
  RefreshCw,
  Search,
  Clock,
  Database,
  Smartphone
} from 'lucide-react';

export default function FlowExecutionsModal({
  flowId,
  flowName,
  token,
  onClose
}) {
  const [executions, setExecutions] = useState([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [statusFilter, setStatusFilter] = useState('ALL');
  const [searchPhone, setSearchPhone] = useState('');
  const [selectedSessionId, setSelectedSessionId] = useState(null);
  const [sessionDetail, setSessionDetail] = useState(null);
  const [loadingDetail, setLoadingDetail] = useState(false);

  const getAuthHeaders = useCallback(() => {
    const activeToken = token || localStorage.getItem('token');
    return activeToken ? { Authorization: `Bearer ${activeToken}` } : {};
  }, [token]);

  const fetchExecutions = useCallback(async () => {
    setLoading(true);
    try {
      const headers = getAuthHeaders();
      const params = new URLSearchParams();
      if (statusFilter !== 'ALL') params.append('status', statusFilter);
      if (searchPhone.trim()) params.append('phone', searchPhone.trim());
      params.append('limit', '50');

      const url = flowId
        ? `/api/flows/conversation-flows/${flowId}/executions?${params.toString()}`
        : `/api/flows/executions?${params.toString()}`;

      const res = await fetch(url, { headers });
      const data = await res.json();
      if (data.success) {
        setExecutions(data.executions || []);
        setTotal(data.total || 0);
      }
    } catch (err) {
      console.error('Failed to fetch executions:', err);
    } finally {
      setLoading(false);
    }
  }, [flowId, statusFilter, searchPhone, getAuthHeaders]);

  useEffect(() => {
    fetchExecutions();
  }, [fetchExecutions]);

  const loadSessionTrace = async (sessionId) => {
    setSelectedSessionId(sessionId);
    setLoadingDetail(true);
    try {

                            {isDraft && (
                              <button
                                onClick={() => handlePushToMeta(flow.id)}
                                disabled={pushingMeta}
                                title="Push assets to Meta Cloud API"
                                style={{
                                  padding: '6px 10px',
                                  borderRadius: '6px',
                                  background: '#EFF6FF',
                                  border: '1px solid #BFDBFE',
                                  color: '#1D4ED8',
                                  fontSize: '0.78rem',
                                  fontWeight: 600,
                                  cursor: 'pointer',
                                  display: 'flex',
                                  alignItems: 'center',
                                  gap: '4px'
                                }}
                              >
                                <UploadCloud size={13} />
                                {flow.meta_flow_id ? 'Re-upload' : 'Push'}
                              </button>
                            )}


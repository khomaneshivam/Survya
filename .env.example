# WhatsApp Bulk Messenger Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration ('mysql' or 'sqlite')
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=whatsapp_bulk_db

# Security & Authentication (Required: at least 32 characters in production)
JWT_SECRET=your_jwt_secret_min_32_characters_long_here

# System Timezone Configuration (e.g. Asia/Kolkata, UTC)
APP_TIMEZONE=Asia/Kolkata

# Local Storage Paths
DATA_DIR=./data
UPLOADS_DIR=./uploads

# Note: Meta WhatsApp Cloud API credentials (Access Token, Phone Number ID, WABA ID,
# Webhook Verify Token, App Secret, Flow settings, and Templates) are completely managed
# inside the SARVYA platform via the UI Settings, Topbar WABA Manager, and the database.
# No Meta variables are required in .env!
